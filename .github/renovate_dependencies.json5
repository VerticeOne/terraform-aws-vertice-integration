// This file is being managed from within https://github.com/VerticeOne/vertice-file-templates, do not edit directly
// The rules live in the presets of https://github.com/VerticeOne/renovate-config, a preset only acts on files the repo has
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>VerticeOne/renovate-config//presets/common.json5",
    "github>VerticeOne/renovate-config//presets/python.json5",
    "github>VerticeOne/renovate-config//presets/node.json5",
    "github>VerticeOne/renovate-config//presets/docker.json5",
    "github>VerticeOne/renovate-config//presets/go.json5",
    "github>VerticeOne/renovate-config//presets/java.json5",
    "github>VerticeOne/renovate-config//presets/terraform.json5",
  ],
  // keeps Terraform CLI version updates (required_version) out of the "terraform monorepo" group of config:recommended;
  // it has to be top-level, an ignorePresets inside a preset only covers what that preset extends
  ignorePresets: ["group:terraformMonorepo", "monorepo:terraform"],
  customManagers: [
    {
      // asdf does not know every tool in .tool-versions (e.g. goreleaser), read them from GitHub releases of <tool>/<tool>
      customType: "regex",
      managerFilePatterns: ["/(^|/)\\.tool-versions$/"],
      matchStrings: [
        "^(?<depName>[a-zA-Z0-9_-]+)\\s+(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)$",
      ],
      datasourceTemplate: "github-releases",
      depNameTemplate: "{{{depName}}}/{{{depName}}}",
      extractVersionTemplate: "^v?(?<version>.*)$",
    },
  ],
  packageRules: [
    {
      groupName: "tools",
      matchManagers: ["custom.regex"],
      matchFileNames: ["**/.tool-versions"],
    },
  ],
}
